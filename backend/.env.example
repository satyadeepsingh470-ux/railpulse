# RailPulse FastAPI Backend Environment Configuration

# Server Port (Default: 8000)
PORT=8000

# WhatsApp Baileys Microservice URL (Default: http://localhost:3001)
WHATSAPP_BRIDGE_URL=http://localhost:3001

# RapidAPI IRCTC Key (Optional: Leave empty for 100% Free Mock / Simulation Mode)
RAPIDAPI_KEY=
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# Gemini 2.5 Flash API Key for AI Confirmation Intelligence & OCR (Optional: Free tier)
GEMINI_API_KEY=

# Background Auto-Poll Interval (APScheduler default: 5 minutes)
POLL_INTERVAL_MINUTES=5
